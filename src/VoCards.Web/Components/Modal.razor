@*
    A dialog with a scrim. Escape and a click on the scrim both close it, and the
    handler is pushed onto the keyboard stack so it wins over whatever is behind.
*@
@implements IDisposable
@inject KeyboardService Keys

<div class="scrim" @onclick="OnScrimClick">
    <div class="modal @(Wide ? "modal-wide" : string.Empty)" role="dialog" aria-modal="true"
         aria-label="@Title" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h2>@Title</h2>
            <button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="Close" aria-label="Close">
                <Icon Name="x" Size="16" />
            </button>
        </div>

        <div class="modal-body">
            @ChildContent
        </div>

        @if (Footer is not null)
        {
            <div class="modal-foot">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public bool Wide { get; set; }

    /// <summary>Raised when the dialog asks to close. The parent owns the open flag.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized() => Keys.Push(this, HandleKey);

    private bool HandleKey(KeyPress press)
    {
        if (!press.Is("Escape"))
        {
            return false;
        }

        _ = Close();
        return true;
    }

    private Task Close() => OnClose.InvokeAsync();

    private Task OnScrimClick() => Close();

    public void Dispose() => Keys.Remove(this);
}
