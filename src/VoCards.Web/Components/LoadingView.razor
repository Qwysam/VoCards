@* Skeleton shown while the library loads out of browser storage. *@

<div class="stack" aria-busy="true" aria-label="Loading">
    <div class="skeleton" style="height: 7rem; border-radius: var(--radius-2xl);"></div>

    <div class="grid grid-stats">
        @for (int i = 0; i < 4; i++)
        {
            <div class="skeleton" style="height: 5.5rem; border-radius: var(--radius-lg);"></div>
        }
    </div>

    <div class="grid grid-decks" style="margin-top: var(--space-4);">
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton" style="height: 9rem; border-radius: var(--radius-xl);"></div>
        }
    </div>
</div>
