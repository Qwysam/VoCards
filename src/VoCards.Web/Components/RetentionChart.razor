@*
    The retention curve: how recall holds up as intervals lengthen.

    One series, so no legend box - the panel title names it. 2px line, >=8px
    markers ringed in the surface colour, and a direct label on the endpoints
    rather than a number on every point.
*@

<div class="chart">
    @if (Points.Count == 0)
    {
        <p class="muted" style="font-size: var(--text-sm); padding: var(--space-6) 0; text-align: center;">
            Not enough review history yet. The curve appears once cards start
            coming back for a second look.
        </p>
    }
    else
    {
        <svg viewBox="0 0 @Width @Height" style="height: @(Height)px;" role="img" aria-label="@AriaLabel">
            @* --- horizontal gridlines at 0/50/100% --- *@
            @foreach (int pct in new[] { 0, 50, 100 })
            {
                double y = YFor(pct / 100d);
                <line class="grid-line" x1="@Format.Number(PadLeft)" x2="@Format.Number(Width - 8)"
                      y1="@Format.Number(y)" y2="@Format.Number(y)" />
                <svg:text class="axis-text" x="0" y="@Format.Number(y + 3)">@pct%</svg:text>
            }

            @* --- the target-retention reference line --- *@
            <line class="grid-line" x1="@Format.Number(PadLeft)" x2="@Format.Number(Width - 8)"
                  y1="@Format.Number(YFor(0.9))" y2="@Format.Number(YFor(0.9))"
                  stroke="var(--good)" stroke-dasharray="4 4" opacity="0.6" />

            <path class="line-mark" d="@Path" stroke="var(--viz-1)" />

            @for (int i = 0; i < Points.Count; i++)
            {
                RetentionPoint point = Points[i];
                <circle class="dot-mark" cx="@Format.Number(XFor(i))" cy="@Format.Number(YFor(point.Retention))"
                        r="5" fill="var(--viz-1)">
                    <title>@point.Label: @Format.PercentLabel(point.Retention) recalled over @point.Reviews reviews</title>
                </circle>
            }

            @* --- direct labels on the first and last points only --- *@
            @if (Points.Count > 0)
            {
                <svg:text class="axis-text" x="@Format.Number(XFor(0))"
                      y="@Format.Number(YFor(Points[0].Retention) - 12)" text-anchor="middle"
                      style="font-weight: 700;">@Format.PercentLabel(Points[0].Retention)</svg:text>
            }

            @if (Points.Count > 1)
            {
                <svg:text class="axis-text" x="@Format.Number(XFor(Points.Count - 1))"
                      y="@Format.Number(YFor(Points[^1].Retention) - 12)" text-anchor="middle"
                      style="font-weight: 700;">@Format.PercentLabel(Points[^1].Retention)</svg:text>
            }

            @for (int i = 0; i < Points.Count; i++)
            {
                <svg:text class="axis-text" x="@Format.Number(XFor(i))" y="@Format.Number(Height - 4)"
                      text-anchor="middle">@Points[i].Label</svg:text>
            }
        </svg>

        <p class="muted" style="font-size: var(--text-xs); margin-top: var(--space-2);">
            The dashed line marks the 90% target the scheduler aims for. Points below it
            mean intervals are running slightly long.
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RetentionPoint> Points { get; set; } = [];

    [Parameter] public int Height { get; set; } = 200;

    private const double Width = 720;
    private const double PadLeft = 34;
    private const double PadTop = 22;
    private const double PadBottom = 22;

    private double XFor(int index) => Points.Count <= 1
        ? PadLeft
        : PadLeft + (index * (Width - PadLeft - 16) / (Points.Count - 1));

    private double YFor(double fraction) =>
        Height - PadBottom - (Math.Clamp(fraction, 0d, 1d) * (Height - PadTop - PadBottom));

    private string Path => string.Join(" ", Points.Select((point, i) =>
        $"{(i == 0 ? "M" : "L")}{Format.Number(XFor(i))},{Format.Number(YFor(point.Retention))}"));

    private string AriaLabel
    {
        get
        {
            if (Points.Count == 0)
            {
                return "Retention curve: no data yet.";
            }

            string span = $"{Points[0].Label} to {Points[^1].Label}";
            return $"Retention curve from {span}, "
                + $"ranging {Format.PercentLabel(Points.Min(p => p.Retention))} to "
                + $"{Format.PercentLabel(Points.Max(p => p.Retention))}.";
        }
    }
}
